{
  "name": "framestudio-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FrameStudio AI — editor de vídeo profissional, multiplataforma, com IA local.",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @framestudio/web",
    "build": "npm run build -w @framestudio/web",
    "preview": "npm run preview -w @framestudio/web",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
