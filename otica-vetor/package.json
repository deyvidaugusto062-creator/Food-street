{
  "name": "otica-vetor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site da Ótica Vetor — Av. Cupecê, 3861, Jardim Prudência, São Paulo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && vite build --mode staging",
    "build:single": "tsc -b && vite build --mode single && vite build --mode single-revisao && node scripts/finish-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test src/**/*.test.ts",
    "render:poster": "node scripts/render-poster.mjs",
    "render:og": "node scripts/render-og.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.56.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
